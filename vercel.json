{
  "rewrites": [
    {
      "source": "/p_:previewId",
      "destination": "/preview.html"
    },
    {
      "source": "/editor/p_:previewId",
      "destination": "/editor/index.html"
    }
  ],
  "headers": [
    {
      "source": "/preview.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/editor/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
